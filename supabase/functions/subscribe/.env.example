# Secrets della Edge Function "subscribe".
# NON committare il file .env reale. Caricali con:
#   supabase secrets set --env-file supabase/functions/subscribe/.env
# oppure dalla dashboard: Edge Functions → subscribe → Secrets.

# Indirizzo del sito, senza "/" finale (usato per i redirect senza JavaScript)
SITE_URL=https://[DOMINIO DA DEFINIRE]

# Origini da cui il modulo può essere inviato, separate da virgola
ALLOWED_ORIGINS=https://[DOMINIO DA DEFINIRE],https://www.[DOMINIO DA DEFINIRE]

# Stringa casuale di almeno 32 caratteri, es. generata con: openssl rand -base64 48
FORM_SECRET=

# Connessione al database con il ruolo form_writer (pooler, transaction mode, porta 6543).
# Copiala da Dashboard → Connect → Transaction pooler e sostituisci utente e password:
# postgresql://form_writer.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres
FORM_DB_URL=
# Solo per test in locale con un Postgres senza SSL; in produzione lascia commentato
# FORM_DB_SSL=disable

# Versione dell'informativa accettata con il consenso (aggiornala se cambi privacy.html)
PRIVACY_VERSION=2026-10-v1

# Anti-spam: secondi minimi tra la comparsa del modulo e l'invio (come MIN_SECONDS in main.js)
MIN_FILL_SECONDS=3
TOKEN_TTL_SECONDS=7200

# Notifica email facoltativa a ogni nuova iscrizione (Brevo). Lascia vuoto per disattivarla.
BREVO_API_KEY=
NOTIFY_TO=[EMAIL DA DEFINIRE]
NOTIFY_FROM=no-reply@[DOMINIO DA DEFINIRE]
