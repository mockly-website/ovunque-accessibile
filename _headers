# Header di sicurezza per Netlify / Cloudflare Pages (stesso contenuto di .htaccess).
# SEGNAPOSTO: sostituire [PROJECT-REF] con il riferimento del progetto Supabase.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://[PROJECT-REF].supabase.co; form-action 'self' https://[PROJECT-REF].supabase.co; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests

/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
